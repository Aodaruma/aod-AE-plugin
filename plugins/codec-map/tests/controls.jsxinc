// Resolve leaves recursively: v0.3 uses nested groups and stable disk IDs.
function codecParam(effect, legacyName) {
    var aliases = {"Drop I-Frames":"Datamosh", "GOP Length":"Refresh Interval", "Temporal Mode":"Frame Mode", "Map Source":"Area", "Compression Map":"Map Layer", "Map Channel":"Channel", "Invert Map":"Invert", "Map Gamma":"Gamma", "Black QP Offset":"Dark Area Bias", "White QP Offset":"Light Area Bias", "Output":"Map Behavior", "Preview":"Display", "Replay Memory (MiB)":"Working Memory (MiB)"};
    var quality = {"Base CRF":"H.264 Quality","VP9 CQ":"VP9 Quality","MPEG-4 Quantizer":"MPEG-4 Quality"};
    var name = aliases[legacyName] || legacyName;
    var nth = 0;
    if (quality.hasOwnProperty(legacyName)) {name=quality[legacyName];}
    var found=[];
    function visit(group) {
        for(var i=1;i<=group.numProperties;i++) {
            var p=group.property(i);
            if(p.propertyType===PropertyType.PROPERTY) {if(p.propertyValueType!==PropertyValueType.NO_VALUE && p.name===name)found.push(p);}
            else {visit(p);}
        }
    }
    visit(effect);
    if(!found[nth])throw new Error("CodecMap control missing: "+legacyName);
    return found[nth];
}
